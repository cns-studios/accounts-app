<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below (API 31+ uses data_extraction_rules.xml).
   The secure store is encrypted with an Android Keystore key, which is never backed up, so a
   restored copy could not be decrypted anyway: keep it (refresh token, authenticator secret) out.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cns_secure.xml" />
</full-backup-content>
