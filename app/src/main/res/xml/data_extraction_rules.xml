<?xml version="1.0" encoding="utf-8"?><!--
   The secure store is encrypted with a non-exportable Android Keystore key, so it is useless on
   another device: exclude it from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cns_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cns_secure.xml" />
    </device-transfer>
</data-extraction-rules>
